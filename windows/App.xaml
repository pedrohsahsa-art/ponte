<Application x:Class="Ponte.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <LinearGradientBrush x:Key="XpButtonFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F5F3E8" Offset="0.48"/><GradientStop Color="#E1DDCA" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Tahoma, Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#24334D"/><Setter Property="Background" Value="#ECE9D8"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,5,3"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="{StaticResource XpButtonFace}"/><Setter Property="Foreground" Value="#24334D"/><Setter Property="BorderBrush" Value="#7F9DB9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
          <Border BorderBrush="#DFFFFFFF" BorderThickness="1,1,0,0" Margin="1" Padding="{TemplateBinding Padding}" CornerRadius="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#DB9B28"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.75"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#003399"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="XpStartButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#286726"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#75BA56" Offset="0"/><GradientStop Color="#318B32" Offset="0.35"/><GradientStop Color="#24702B" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style>
    <Style x:Key="XpCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="27"/><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#DAECFF"/><Setter Property="Background" Value="#287BEC"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7F9DB9"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="BorderBrush" Value="#7F9DB9"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Padding" Value="4,2"/><Setter Property="Foreground" Value="#24334D"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Padding" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><DockPanel><Border DockPanel.Dock="Top" CornerRadius="4,4,0,0" BorderBrush="#91A9D1" BorderThickness="1,1,1,0" Padding="10,7"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#C7D7F1" Offset="1"/></LinearGradientBrush></Border.Background><ContentPresenter ContentSource="Header" TextElement.Foreground="#003399" TextElement.FontWeight="Bold"/></Border><Border Background="White" CornerRadius="0,0,4,4" BorderBrush="#91A9D1" BorderThickness="1,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#DCEAFF"/><Setter TargetName="Selection" Property="BorderBrush" Value="#6E9BDD"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#9DBBE8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListViewItem"><Setter Property="Padding" Value="6,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#F2F0E5"/><Setter Property="Foreground" Value="#24334D"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#D4D0C8"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="#FCFCF7"/><Setter Property="BorderBrush" Value="#919B9C"/><Setter Property="Padding" Value="0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="20,9"/><Setter Property="Foreground" Value="#24334D"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabFace" CornerRadius="3,3,0,0" Background="#E7E5D8" BorderBrush="#919B9C" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,2,2,0"><ContentPresenter x:Name="TabLabel" ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFace" Property="Background" Value="#FCFCF7"/><Setter TargetName="TabFace" Property="BorderThickness" Value="1,3,1,0"/><Setter TargetName="TabFace" Property="BorderBrush" Value="#E6A12D"/><Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="Bold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#003399"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
